prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: tree-sitter-wisp
Description: Wisp (SRFI-119) grammar for tree-sitter
Version: 0.1.0
URL: https://github.com/tree-sitter/tree-sitter-wisp
Libs: -L${libdir} -ltree-sitter-wisp
Cflags: -I${includedir}
